# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=rezervacije@upmakeup.ba
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (rate limiting). Optional — bez ovih var-i koristi se in-memory fallback (dev/test).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin email allowlist — comma-separated. Test/staging only; NIKAD ne postavljati u prod.
# `scripts/setup-test-env.sh` automatski upisuje test@admin.com u .env.test.
# ADMIN_EMAILS_EXTRA=

# Web Push (admin notifications)
# Generate sa: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY je exposed klijentu (potrebno za PushManager.subscribe).
# VAPID_PRIVATE_KEY je SAMO server-side, NIKAD u client bundle.
# VAPID_SUBJECT je kontakt (mailto: ili https: URL) — push provider koristi za ko šalje.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:una@upmakeup.example
